    <!-- Onboarding -->
    <string name="onb_welcome_title">Your keyboard. Your data. Nowhere else.</string>
    <string name="onb_welcome_body">IOKey is a privacy-first keyboard with a tiny on-device language model.\n\n• No internet permission — at all\n• Learns your writing style locally\n• Encrypted on-device storage\n• No analytics, no accounts, no cloud</string>
