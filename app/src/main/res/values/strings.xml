    <!-- ══════════ Keyboard layout ══════════ -->
    <string name="sec_layout">Keyboard layout</string>
    <string name="layout_intro">Fewer keys in the bottom row means a wider space bar and bigger keys everywhere.</string>
    <string name="layout_spacing">Key spacing</string>
    <string name="layout_spacing_hint">Tighter spacing makes the key faces bigger without making the keyboard taller.</string>
    <string name="layout_bottom_row">Bottom row</string>
    <string name="layout_emoji_key">Emoji key</string>
    <string name="layout_emoji_key_hint">Off: the space bar grows. Emoji stay reachable from the emoji row above the keys.</string>
    <string name="layout_comma_key">Comma key</string>
    <string name="layout_apostrophe_key">Apostrophe key</string>
    <string name="layout_apostrophe_hint">English types more apostrophes than commas. Off: apostrophe is the first item on the comma\'s long-press.</string>
    <string name="layout_letters">Letter layout</string>
    <string name="layout_letters_hint">QWERTY, QWERTZ, AZERTY, Colemak or Dvorak. Autocorrect re-learns which keys sit next to each other, so corrections stay accurate on any layout.</string>
    <string name="settings_keys">Choose your keys</string>
    <string name="settings_keys_hint">Presets and per-key switches, with a live preview.</string>
    <string name="layout_brackets">Bracket key position</string>
    <string name="layout_brackets_hint">Where &lt; &gt; [ ] { } sits on the symbols page. It used to take the slot next to backspace — the one your thumb goes to for ? — so it now sits on the left. Hidden puts &lt; and &gt; on the =\\&lt; page, long-pressing the = key.</string>
    <string name="layout_selection_key">Cursor and selection key</string>
    <string name="layout_selection_key_hint">Adds a key that opens arrows, select, cut, copy and paste — so you can place the caret without reaching for the screen.</string>
    <string name="settings_motion">Animated background and battery</string>
    <string name="settings_motion_hint">Live background styles, frame rate, key outlines and the render counters.</string>
    <string name="settings_data_controls">Data and network controls</string>
    <string name="settings_data_controls_hint">Network switch, what has left this device, per-app rules, backup and restore.</string>
    <string name="layout_symbols">Symbols page</string>
    <string name="layout_symbols_roomy">Roomy</string>
    <string name="layout_symbols_complete">Complete</string>
    <string name="layout_symbols_hint">Roomy keeps symbol keys the same width as letter keys, with brackets on long-press. Complete puts every symbol on page 1 with narrower keys.</string>
    <string name="layout_reset">Reset layout to defaults</string>

