<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/test_lab_title"
        android:textColor="@color/app_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="@string/test_lab_desc"
        android:textColor="@color/app_text"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_test_lab_run"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/test_lab_run" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_test_lab_copy"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/test_lab_copy" />
    </LinearLayout>

    <TextView
        android:id="@+id/test_lab_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:alpha="0.6"
        android:text="@string/test_lab_idle"
        android:textColor="@color/app_text"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/test_lab_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/test_lab_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/app_text"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </ScrollView>
</LinearLayout>
