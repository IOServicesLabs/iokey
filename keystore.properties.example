# Copy to keystore.properties and fill in to build a signed release locally.
# keystore.properties is gitignored; this example is not.
#
# storeFile may be absolute, or relative to the project root. Keep the actual
# keystore OUTSIDE the repository so it can never be committed by accident.
#
# Without this file the release build falls back to debug signing: it still
# builds and installs, it just cannot update an existing release install.
storeFile=../secrets/release.keystore
storePassword=CHANGE_ME
keyAlias=localboard
keyPassword=CHANGE_ME
